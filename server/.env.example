# ===== Runtime =====
NODE_ENV=development
PORT=3000

# ===== Database =====
MONGODB_URI=mongodb://localhost:27017/banana_game

# ===== Session =====
SESSION_SECRET=dev_secret_at_least_32_characters_long_change_me
COOKIE_SECURE=false

# ===== App URL (used in OAuth callback URLs) =====
CLIENT_URL=http://localhost:5173
AUTH_CALLBACK_URL=http://localhost:3000

# ===== Password reset =====
PASSWORD_RESET_TTL_MINUTES=30

# ===== Email delivery (optional) =====
# Without SMTP settings, reset links are written to the server log and
# returned to the browser only in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Banana Quiz <no-reply@bananaquiz.local>

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== Facebook OAuth =====
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ===== Game tuning (optional — omit to use defaults) =====
# Round time limits are defined per mode in src/config/gameModes.js
GAME_BASE_POINTS=100
GAME_FAST_BONUS_MAX=50
GAME_FAST_THRESHOLD_MS=10000
GAME_MAX_STREAK_MULTIPLIER=2.0
BANANA_API_TIMEOUT_MS=8000
BANANA_API_MAX_RETRIES=3